# Database (PostgreSQL + RDKit cartridge)
DATABASE_URL=postgresql+asyncpg://chemvault:chemvault@localhost:5432/chemvault

# Valkey (Redis-compatible)
REDIS_URL=redis://localhost:6379

# Sentinel Auth
SENTINEL_URL=http://localhost:9003
SENTINEL_SERVICE_NAME=chem-vault
SENTINEL_SERVICE_KEY=
SENTINEL_IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
SENTINEL_CACHE_TTL=120

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Storage (fsspec)
STORAGE_ROOT=/data/storage

# App
APP_ENV=development
LOG_LEVEL=DEBUG
