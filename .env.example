# Database (PostgreSQL + RDKit cartridge)
DATABASE_URL=postgresql+asyncpg://cellar:cellar@localhost:5432/cellar

# Valkey (Redis-compatible)
REDIS_URL=redis://localhost:6379

# Sentinel Auth
SENTINEL_URL=http://localhost:9003
SENTINEL_SERVICE_NAME=cellar
SENTINEL_SERVICE_KEY=
SENTINEL_IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Required since Sentinel 0.11.0 (authz mode). Must equal your OAuth client_id
# (same value as the frontend's APP_GOOGLE_CLIENT_ID).
SENTINEL_IDP_AUDIENCE=
SENTINEL_IDP_ISSUER=https://accounts.google.com
SENTINEL_CACHE_TTL=120

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Storage (fsspec)
STORAGE_ROOT=/data/storage

# App
APP_ENV=development
LOG_LEVEL=DEBUG
