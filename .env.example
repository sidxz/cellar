# Database (PostgreSQL + RDKit cartridge)
DATABASE_URL=postgresql+asyncpg://cellar:cellar@localhost:5432/cellar

# Valkey (Redis-compatible)
REDIS_URL=redis://localhost:6379

# Duar Auth
DUAR_URL=http://localhost:9003
DUAR_SERVICE_NAME=cellar
DUAR_SERVICE_KEY=
DUAR_IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Required since Duar 0.11.0 (authz mode). Must equal your OAuth client_id
# (same value as the frontend's APP_GOOGLE_CLIENT_ID).
DUAR_IDP_AUDIENCE=
DUAR_IDP_ISSUER=https://accounts.google.com
DUAR_CACHE_TTL=120

# prot-cellar (sister app that owns the target catalog). Targets are mirrored
# from its API using the caller's own Duar credentials (shared realm).
PROT_CELLAR_URL=http://localhost:8001

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Storage (fsspec)
STORAGE_ROOT=/data/storage

# App
APP_ENV=development
LOG_LEVEL=DEBUG

# ── Production image deploy (docker-compose.prod.yml) ──────────────
# Image tag to run. Defaults to "latest" (main HEAD). Pin a release, e.g. 0.2.0,
# for reproducible/immutable deploys.
CELLAR_TAG=latest
# Browser-reachable backend URL (single-host: the published backend port).
# Use https://… behind a TLS-terminating reverse proxy in real deployments.
APP_API_URL=http://localhost:8000
APP_URL=http://localhost:3000
APP_DUAR_URL=http://localhost:9003
APP_PROT_CELLAR_URL=http://localhost:3001
APP_IDP_PROVIDER=google
APP_GOOGLE_CLIENT_ID=
APP_ENTRA_ID_CLIENT_ID=
APP_ENTRA_ID_TENANT_ID=

# ── Datastore credentials ──────────────────────────────────────────
# Local dev uses the compose built-in fallbacks (cellar / temporal / infisical)
# when these are unset, so `make up` needs none of them. For ANY real
# deployment, UNCOMMENT and set strong unique values generated by a CSPRNG and
# store them in your secrets manager — do not commit real secrets.
# POSTGRES_USER=cellar
# POSTGRES_PASSWORD=
# POSTGRES_DB=cellar
# TEMPORAL_DB_USER=temporal
# TEMPORAL_DB_PASSWORD=
# INFISICAL_DB_USER=infisical
# INFISICAL_DB_PASSWORD=
# INFISICAL_DB_NAME=infisical
# Infisical app secrets (compose has dev fallbacks; override for prod):
# INFISICAL_ENCRYPTION_KEY=
# INFISICAL_JWT_SIGNUP=
# INFISICAL_JWT_AUTH=
# INFISICAL_JWT_REFRESH=
# INFISICAL_AUTH_SECRET=
# Backend's Infisical machine-identity token + project. In dev these are
# auto-populated into .env by scripts/bootstrap-infisical.sh during `make up`
# (and stripped by `make nuke`); set them manually for prod deployments:
# INFISICAL_TOKEN=
# INFISICAL_PROJECT_ID=
