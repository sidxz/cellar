{
  "proto_kinase": {
    "name": "EGFR Kinase Inhibition IC50",
    "description": "Biochemical assay measuring inhibition of EGFR kinase activity using a fluorescence-based ADP detection method. Compounds tested at 10 concentrations in 3-fold serial dilution from 10 uM.",
    "protocol_type": "biochemical",
    "target_ref": "target_egfr",
    "category": "Enzyme Assay",
    "readout_definitions": [
      {
        "name": "% Inhibition",
        "data_type": "numeric",
        "unit": "%",
        "precision": 1,
        "normalization": "percent_inhibition",
        "display_order": 1
      },
      {
        "name": "IC50",
        "data_type": "dose_response",
        "unit": "nM",
        "precision": 2,
        "display_order": 2,
        "dose_response_config": {
          "curve_type": "ic50",
          "x_readout_name": "Concentration",
          "y_readout_name": "% Inhibition"
        }
      }
    ],
    "condition_definitions": [
      {
        "name": "ATP Concentration",
        "data_type": "numeric",
        "unit": "uM"
      },
      {
        "name": "Incubation Time",
        "data_type": "numeric",
        "unit": "min"
      }
    ],
    "publish": true
  },
  "proto_cox2": {
