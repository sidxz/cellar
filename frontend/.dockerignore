# Never ship local installs/builds into the image — node_modules is
# platform-specific (darwin vs linux) and overlaying it on the deps stage
# breaks pnpm's dependency verification during `pnpm build`.
node_modules
.next
.turbo
coverage
playwright-report
test-results

# Local logs & env files (runtime config comes from APP_* vars, not baked env)
*.log
.env
.env.*

Dockerfile
.dockerignore
