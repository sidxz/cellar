{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "a11y": {
        "noLabelWithoutControl": "warn",
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn",
        "useButtonType": "warn",
        "noSvgWithoutTitle": "warn"
      }
    }
  },
  "files": {
    "ignore": [".next/", "node_modules/", "src/shared/lib/api/", "src/shared/components/ui/"]
  }
}
