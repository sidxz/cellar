# ── Runtime Config (APP_*) ─────────────────────────────────────
# Read by the container at runtime via /api/config endpoint.
# No build-time baking — one Docker image works across all environments.
APP_API_URL=http://localhost:8000
APP_URL=http://localhost:3000
APP_DUAR_URL=http://localhost:9003
APP_PROT_CELLAR_URL=http://localhost:3001
APP_IDP_PROVIDER=google
APP_GOOGLE_CLIENT_ID=
APP_ENTRA_ID_CLIENT_ID=
APP_ENTRA_ID_TENANT_ID=

# ── Server-only secrets (never sent to browser) ────────────────
# Required since Duar 0.11.0: the /api/auth/mint route forwards authz-token
# minting to Duar with this service key. Use a "cellar" service key (you can
# reuse the cellar backend's DUAR_SERVICE_KEY).
APP_DUAR_SERVICE_KEY=

# ── Server-only (middleware) ───────────────────────────────────
# Used by Next.js edge middleware for JWT validation (never sent to browser).
DUAR_URL=http://localhost:9003
IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ── Dev fallback (NEXT_PUBLIC_*) ──────────────────────────────
# Only needed for local dev without Docker (fallback if /api/config unreachable).
# In production, APP_* vars above are authoritative.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DUAR_URL=http://localhost:9003
NEXT_PUBLIC_PROT_CELLAR_URL=http://localhost:3001
NEXT_PUBLIC_IDP_PROVIDER=google
NEXT_PUBLIC_IDP_CLIENT_ID=
