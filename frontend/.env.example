# Sentinel Auth (client-side — bundled into browser JS)
NEXT_PUBLIC_SENTINEL_URL=http://localhost:9003
NEXT_PUBLIC_IDP_PROVIDER=google
NEXT_PUBLIC_IDP_CLIENT_ID=your-google-oauth-client-id
NEXT_PUBLIC_ENTRA_TENANT_ID=

# Sentinel Auth (server-side only — used by edge middleware)
SENTINEL_URL=http://localhost:9003
IDP_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
