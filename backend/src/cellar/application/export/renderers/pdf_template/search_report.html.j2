<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ brand }} · {{ title }}</title>
  {%- if extras.exported_by %}
  <meta name="author" content="{{ extras.exported_by }}">
  {%- endif %}
  <meta name="generator" content="{{ brand }}">
  <link rel="stylesheet" href="search_report.css">
</head>
<body>
  {#- Repeated in every page's footer, so a page on its own still says who exported it when. -#}
  <div class="page-footer">{{ attribution }}</div>

  <header class="report-header">
    <div class="brand-row">
      <div class="brand">
        <img class="logo" src="{{ logo_src }}" alt="">
        <span class="wordmark">{{ brand }}</span>
      </div>
      <div class="report-meta">
        {%- if extras.exported_at %}
          <span class="meta-row">Exported {{ extras.exported_at }}</span>
        {%- endif %}
        {%- if extras.exported_by %}
          <span class="meta-row">by {{ extras.exported_by }}</span>
        {%- endif %}
      </div>
    </div>
    <div class="report-title-row">
      <h1>{{ title }}</h1>
      <div class="report-meta">
        <span class="meta-row">{{ row_count }} {{ "compound" if row_count == 1 else "compounds" }}</span>
        {%- if extras.aggregation_label %}
          <span class="meta-row">{{ extras.aggregation_label }}</span>
        {%- endif %}
      </div>
    </div>
    {%- if extras.query_summary %}
      <p class="query-summary">{{ extras.query_summary }}</p>
    {%- endif %}
    {%- if image_omission_reason %}
      <p class="image-notice">{{ image_omission_reason }}</p>
    {%- endif %}
  </header>

  <table>
    <colgroup>
      {%- for c in columns -%}
        <col class="col-{{ c.kind }}{% if c.key in identity_keys %} col-id{% endif %}">
      {%- endfor -%}
    </colgroup>
    <thead>
      {#- Group-header rows: consecutive columns sharing a protocol span one cell,
          and under a split protocol, so do its groups. An overlaid group carries
          a swatch in its curve's colour, the key to the overlay plot. -#}
      {%- for spans in [group_spans, subgroup_spans] if spans | selectattr('label') | list -%}
        <tr class="group-row">
          {%- for g in spans -%}
            {%- if g.label -%}
              <th colspan="{{ g.span }}" class="group-header">
                {%- if g.color -%}<span class="swatch" style="background: {{ g.color }}"></span>{%- endif -%}
                {{ g.label }}
              </th>
            {%- else -%}
              {%- for _ in range(g.span) -%}<th class="group-spacer"></th>{%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </tr>
      {%- endfor -%}
      <tr>
        {%- for c in columns -%}
          <th class="th-{{ c.kind }}">{{ c.header }}{%- if c.unit %} <span class="unit">({{ c.unit }})</span>{%- endif -%}</th>
        {%- endfor -%}
      </tr>
    </thead>
    <tbody>
      {%- for rr in rendered_rows -%}
        {%- set row = rr.row -%}
        <tr>
          {%- for c in columns -%}
            <td class="cell-{{ c.kind }}{% if c.key in identity_keys %} cell-id{% endif %}">
              {%- set v = row.cells.get(c.key) -%}
              {%- if c.kind == "image_structure" -%}
                {%- if rr.images.get("structure") -%}
                  <img src="{{ rr.images['structure'] }}" width="{{ struct_w }}" height="{{ struct_h }}" alt="structure">
                {%- else -%}
                  <span class="muted">—</span>
                {%- endif -%}
              {%- elif c.kind == "image_curve" -%}
                {%- if rr.images.get(c.key) -%}
                  <img src="{{ rr.images[c.key] }}" width="{{ sparkline_w }}" height="{{ sparkline_h }}" alt="dose response">
                {%- else -%}
                  <span class="muted">—</span>
                {%- endif -%}
              {%- elif c.kind == "qualifier" -%}
                {%- if v in (None, "", "=") -%}{%- else -%}<span class="qual">{{ v }}</span>{%- endif -%}
              {%- elif c.kind == "smiles" -%}
                {%- if v -%}<code class="smiles">{{ v }}</code>{%- else -%}<span class="muted">—</span>{%- endif -%}
              {%- else -%}
                {%- set text = v | cell_text(c) -%}
                {%- if text is none -%}<span class="muted">—</span>{%- else -%}{{ text }}{%- endif -%}
              {%- endif -%}
            </td>
          {%- endfor -%}
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
</body>
</html>
