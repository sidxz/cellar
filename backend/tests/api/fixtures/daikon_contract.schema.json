{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DAIKON Published Campaign Contract",
  "description": "JSON Schema for GET /api/v1/campaigns/{id}/published — spec §6.",
  "type": "object",
  "required": ["campaign", "compound_sources", "source_protocols", "channels", "stages", "results"],
  "additionalProperties": false,
  "properties": {
    "campaign": {
      "type": "object",
      "required": ["id", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "id":                          { "type": "string", "format": "uuid" },
        "name":                        { "type": "string" },
        "description":                 { "type": ["string", "null"] },
        "project": {
          "oneOf": [
            {
              "type": "object",
              "required": ["id", "name"],
              "additionalProperties": false,
              "properties": {
                "id":   { "type": "string", "format": "uuid" },
                "name": { "type": "string" }
              }
            },
            { "type": "null" }
          ]
        },
        "status":                      { "type": "string", "enum": ["draft", "closed", "superseded"] },
        "closed_at":                   { "type": ["string", "null"] },
        "closed_by": {
          "oneOf": [
            {
              "type": "object",
              "required": ["id"],
              "additionalProperties": false,
              "properties": {
                "id":   { "type": "string", "format": "uuid" },
                "name": { "type": ["string", "null"] }
              }
            },
            { "type": "null" }
          ]
        },
        "close_note":                  { "type": ["string", "null"] },
        "supersedes_campaign_id":      { "type": ["string", "null"] },
        "superseded_by_campaign_id":   { "type": ["string", "null"] }
      }
    },

    "compound_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": true,
        "properties": {
          "kind":        { "type": "string", "enum": ["manual", "collection", "saved_search", "campaign", "run"] },
          "description": { "type": ["string", "null"] },
          "count":       { "type": "integer" }
        }
      }
    },

    "source_protocols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id":      { "type": "string", "format": "uuid" },
          "name":    { "type": "string" },
          "version": { "type": ["integer", "number", "null"] },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id":   { "type": "string", "format": "uuid" },
                  "name": { "type": "string" }
                }
              },
              { "type": "null" }
            ]
          }
        }
      }
    },

    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "display_order", "protocol_ref", "readout", "source_kind", "selection_rule", "resolve_from_all_runs"],
        "additionalProperties": false,
        "properties": {
          "id":             { "type": "string", "format": "uuid" },
          "label":          { "type": "string" },
          "display_order":  { "type": "integer" },
          "protocol_ref": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id":      { "type": "string", "format": "uuid" },
              "name":    { "type": ["string", "null"] },
              "version": { "type": ["integer", "number", "null"] }
            }
          },
          "readout": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id":        { "type": "string", "format": "uuid" },
              "name":      { "type": ["string", "null"] },
              "unit":      { "type": ["string", "null"] },
              "data_type": { "type": ["string", "null"] }
            }
          },
          "source_kind":     { "type": "string" },
          "selection_rule":  { "type": "string" },
          "resolve_from_all_runs": { "type": "boolean" },
          "qc_filter": {
            "oneOf": [
              { "type": "object" },
              { "type": "null" }
            ]
          }
        }
      }
    },

    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "parent_stage_id", "display_order", "kind", "criteria", "counts"],
        "additionalProperties": false,
        "properties": {
          "id":              { "type": "string", "format": "uuid" },
          "name":            { "type": "string" },
          "parent_stage_id": { "type": ["string", "null"] },
          "display_order":   { "type": "integer" },
          "kind":            { "type": "string", "enum": ["criteria", "manual"] },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["channel_id", "operator", "value"],
              "additionalProperties": false,
              "properties": {
                "channel_id": { "type": "string", "format": "uuid" },
                "operator":   { "type": "string", "enum": ["lt", "lte", "gt", "gte", "between"] },
                "value": {
                  "oneOf": [
                    { "type": "number" },
                    { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                  ]
                }
              }
            }
          },
          "counts": {
            "type": "object",
            "required": ["population", "hit", "miss", "untested", "pending", "not_in_stage", "overridden"],
            "additionalProperties": false,
            "properties": {
              "population":   { "type": "integer" },
              "hit":          { "type": "integer" },
              "miss":         { "type": "integer" },
              "untested":     { "type": "integer" },
              "pending":      { "type": "integer" },
              "not_in_stage": { "type": "integer" },
              "overridden":   { "type": "integer" }
            }
          }
        }
      }
    },

    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["molecule", "measurements", "stage_outcomes"],
        "additionalProperties": false,
        "properties": {
          "molecule": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id":               { "type": "string", "format": "uuid" },
              "primary_id":       { "type": ["string", "null"] },
              "name":             { "type": ["string", "null"] },
              "structure_smiles": { "type": ["string", "null"] }
            }
          },
          "representative_batch": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id", "name"],
                "additionalProperties": false,
                "properties": {
                  "id":   { "type": "string", "format": "uuid" },
                  "name": { "type": "string" }
                }
              },
              { "type": "null" }
            ]
          },
          "notes":           { "type": ["string", "null"] },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["channel_id", "value_qualifier", "unit", "is_manual_override"],
              "additionalProperties": false,
              "properties": {
                "channel_id":        { "type": "string", "format": "uuid" },
                "value":             { "type": ["number", "integer", "null"] },
                "value_qualifier":   { "type": "string" },
                "unit":              { "type": "string" },
                "is_manual_override":{ "type": "boolean" },
                "override_reason":   { "type": ["string", "null"] },
                "test_concentration": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["value"],
                      "additionalProperties": false,
                      "properties": {
                        "value": { "type": ["number", "integer", "null"] },
                        "unit":  { "type": ["string", "null"] }
                      }
                    },
                    { "type": "null" }
                  ]
                },
                "replicate_count":   { "type": ["integer", "null"] },
                "qc_pass":           { "type": ["boolean", "null"] },
                "contributing_run_ids": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": { "type": "string", "format": "uuid" }
                    },
                    { "type": "null" }
                  ]
                },
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["run_id"],
                      "additionalProperties": false,
                      "properties": {
                        "run_id":            { "type": "string", "format": "uuid" },
                        "run_date":          { "type": ["string", "null"] },
                        "protocol_name":     { "type": ["string", "null"] },
                        "protocol_version":  { "type": ["integer", "number", "null"] },
                        "curve_id":          { "type": ["string", "null"] },
                        "readout_id":        { "type": ["string", "null"] }
                      }
                    },
                    { "type": "null" }
                  ]
                }
              }
            }
          },
          "stage_outcomes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stage_id", "outcome", "overridden", "checks"],
              "additionalProperties": false,
              "properties": {
                "stage_id":        { "type": "string", "format": "uuid" },
                "outcome":         { "type": "string", "enum": ["hit", "miss", "untested", "not_in_stage", "pending"] },
                "overridden":      { "type": "boolean" },
                "override_reason": { "type": ["string", "null"] },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["channel_id", "verdict"],
                    "additionalProperties": false,
                    "properties": {
                      "channel_id": { "type": "string", "format": "uuid" },
                      "verdict":    { "type": "string", "enum": ["pass", "fail", "untested"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "pagination": {
      "type": "object",
      "required": ["next_cursor", "total"],
      "additionalProperties": false,
      "properties": {
        "next_cursor": { "type": ["string", "null"] },
        "total":       { "type": "integer" }
      }
    }
  }
}
